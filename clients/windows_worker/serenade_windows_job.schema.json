{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serenade.dev/schemas/windows_job.json",
  "title": "Serenade Windows worker job",
  "description": "Wire format for jobs published from the Linux orchestrator to a Windows worker via Redis.",
  "type": "object",
  "required": ["job_id", "engagement_id", "kind", "submitted_at", "auth_token"],
  "properties": {
    "job_id":         { "type": "string", "minLength": 8, "maxLength": 64,
                        "description": "ULID assigned by the orchestrator." },
    "engagement_id":  { "type": "string", "format": "uuid" },
    "kind":           { "enum": ["mimikatz", "assembly", "shell"] },
    "args":           { "type": "array", "items": { "type": "string" }, "default": [] },
    "exe":            { "type": "string", "description": "Filename under $ToolsDir; only for kind=shell." },
    "assembly_b64":   { "type": "string", "description": "Base64-encoded .NET assembly; only for kind=assembly." },
    "assembly_sig":   { "type": "string", "minLength": 64, "maxLength": 64,
                        "description": "R3: hex HMAC-SHA256 over the raw assembly bytes, keyed on SERENADE_WINDOWS_WORKER_SIGNING_KEY. Required for kind=assembly; worker rejects mismatched sigs." },
    "timeout_seconds":{ "type": "integer", "minimum": 1, "maximum": 3600, "default": 120 },
    "submitted_at":   { "type": "string", "format": "date-time" },
    "auth_token":     { "type": "string", "minLength": 16,
                        "description": "Shared secret between orchestrator and worker; rotated per-deployment." }
  },
  "additionalProperties": false,
  "oneOf": [
    { "properties": { "kind": { "const": "mimikatz" } } },
    { "properties": { "kind": { "const": "assembly" }, "assembly_b64": { "type": "string", "minLength": 1 }, "assembly_sig": { "type": "string" } },
      "required": ["assembly_b64", "assembly_sig"] },
    { "properties": { "kind": { "const": "shell" }, "exe": { "type": "string", "minLength": 1 } },
      "required": ["exe"] }
  ]
}
